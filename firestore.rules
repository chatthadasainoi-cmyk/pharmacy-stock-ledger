rules_version = '2';

// คัดลอกทั้งไฟล์ไปวางที่ Firebase console → Firestore Database → Rules แล้วกด Publish
//
// ตอนนี้ (ชั่วคราว): ใครก็ได้ที่ล็อกอินด้วยบัญชี Google เข้าอ่าน/เขียนข้อมูลร้านได้
// ถ้าจะจำกัดเฉพาะบางอีเมลภายหลัง ให้เปลี่ยนเงื่อนไขเป็น:
//   request.auth != null && request.auth.token.email.lower() in ['someone@gmail.com']
service cloud.firestore {
  match /databases/{database}/documents {
    match /shops/{shopId}/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
